---
import { Font } from 'astro:assets'
import '@/styles/global.css'
import Seo from '@/components/Seo.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { ALTERNOS_INICIO, rutaOg, type Alternos } from '@/i18n/rutas'

interface Props {
  idioma: Idioma
  titulo?: string
  descripcion?: string
  noIndex?: boolean
  /** La misma página en cada idioma; por defecto, la home. */
  alternos?: Alternos | undefined
  /** Imagen Open Graph; por defecto, la de la home. */
  imagenOg?: string | undefined
}

const {
  idioma,
  titulo,
  descripcion,
  noIndex = false,
  alternos = ALTERNOS_INICIO,
  imagenOg = rutaOg(idioma, 'inicio')
} = Astro.props
const t = obtenerDiccionario(idioma)
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      ;(() => {
        let tema = null
        try {
          tema = localStorage.getItem('tema')
        } catch {
          // Sin almacenamiento: queda el modo oscuro.
        }
        // Sin elección guardada, el sitio arranca en modo oscuro.
        if (tema !== 'light') tema = 'dark'
        document.documentElement.dataset.theme = tema
      })()
    </script>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />
    <Seo
      idioma={idioma}
      titulo={titulo ?? t.meta.titulo}
      descripcion={descripcion ?? t.meta.descripcion}
      noIndex={noIndex}
      alternos={alternos}
      imagen={imagenOg}
    />
  </head>
  <body class="bg-bg font-sans text-fg antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-accent-solid focus:px-4 focus:py-2 focus:text-white"
    >
      {t.nav.saltar}
    </a>
    <Header idioma={idioma} alternos={alternos} />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer idioma={idioma} />
  </body>
</html>
