---
import { Icon } from 'astro-icon/components'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/ui/Button.astro'
import { rutaOg } from '@/i18n/rutas'
import {
  GUIA,
  PARTES,
  RUTA_GUIA,
  obtenerCapitulos,
  primerCapituloDelTutorial,
  rutaDeCapitulo
} from '@/data/guia'

const capitulos = await obtenerCapitulos()
const primero = capitulos[0]
const primeroDelTutorial = await primerCapituloDelTutorial()
---

<BaseLayout
  idioma="es"
  titulo={`${GUIA.titulo} | Patricio R. Polito`}
  descripcion={GUIA.descripcion}
  alternos={{ es: RUTA_GUIA }}
  imagenOg={rutaOg('es', 'guia/inicio')}
>
  <header class="px-4 pt-32 pb-12 sm:px-6 sm:pt-40">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-sm font-semibold tracking-wider text-accent uppercase">
        Guía · {capitulos.length} capítulos · en español
      </p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-balance text-strong sm:text-5xl">
        {GUIA.titulo}
      </h1>
      <p class="mt-6 text-xl text-muted">{GUIA.bajada}</p>

      <ul class="mt-8 space-y-3">
        {GUIA.logros.map((logro) => (
          <li class="flex items-start gap-3">
            <Icon
              name="lucide:circle-check"
              class="mt-0.5 size-5 shrink-0 text-accent"
              aria-hidden="true"
            />
            <span>{logro}</span>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap gap-4">
        {primero && (
          <Button href={rutaDeCapitulo(primero.slug)} icono="lucide:book-open">
            Empezar por el capítulo 1
          </Button>
        )}
        {primeroDelTutorial && (
          <Button
            href={rutaDeCapitulo(primeroDelTutorial.slug)}
            variante="secundario"
            icono="lucide:hammer"
          >
            Ir directo al paso a paso
          </Button>
        )}
      </div>
      <p class="mt-6 text-sm text-muted">{GUIA.aviso}</p>
    </div>
  </header>

  {PARTES.map((parte) => {
    const lista = capitulos.filter((c) => c.parte.id === parte.id)
    return (
      <section
        id={parte.id}
        aria-labelledby={`${parte.id}-titulo`}
        class="px-4 pb-14 sm:px-6"
      >
        <div class="mx-auto max-w-4xl">
          <h2
            id={`${parte.id}-titulo`}
            class="text-2xl font-bold tracking-tight text-strong"
          >
            Parte {parte.numero} · {parte.titulo}
          </h2>
          <p class="mt-2 text-muted">{parte.descripcion}</p>
          <ol class="mt-6 grid gap-4">
            {lista.map((c) => (
              <li class="group relative flex gap-4 rounded-2xl border border-line bg-surface p-5 transition-colors hover:border-sky-500/40">
                <span
                  class="flex size-10 shrink-0 items-center justify-center rounded-full bg-accent-soft font-mono font-bold text-accent"
                  aria-hidden="true"
                >
                  {c.numero}
                </span>
                <div>
                  <h3 class="font-semibold text-strong">
                    <a
                      href={rutaDeCapitulo(c.slug)}
                      class="after:absolute after:inset-0 group-hover:text-accent"
                    >
                      <span class="sr-only">Capítulo {c.numero}: </span>
                      {c.titulo}
                    </a>
                  </h3>
                  <p class="mt-1 text-sm text-muted">{c.resumen}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  })}
</BaseLayout>
