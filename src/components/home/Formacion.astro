---
import { Icon } from 'astro-icon/components'
import Section from '@/components/ui/Section.astro'
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { rutaDeCaso } from '@/data/casos'

interface Props {
  idioma: Idioma
}

const { idioma } = Astro.props
const t = obtenerDiccionario(idioma)
---

<Section
  id="formacion"
  eyebrow={t.formacion.eyebrow}
  titulo={t.formacion.titulo}
>
  <ul class="grid gap-6 md:grid-cols-5">
    {t.formacion.items.map((item) => (
      <li
        class:list={[
          'flex gap-4 rounded-2xl border p-6',
          item.destacado
            ? 'border-sky-500/40 bg-accent-soft md:col-span-3'
            : 'border-line bg-surface md:col-span-2'
        ]}
      >
        <Icon
          name="lucide:graduation-cap"
          class:list={[
            'shrink-0 text-accent',
            item.destacado ? 'size-9' : 'size-7'
          ]}
          aria-hidden="true"
        />
        <div>
          <h3
            class:list={['font-bold text-strong', item.destacado && 'text-xl']}
          >
            {item.titulo}
          </h3>
          <p class="text-muted">{item.institucion}</p>
          <p class="mt-1 font-mono text-sm text-accent">{item.detalle}</p>
          {item.nota && <p class="mt-3 text-sm">{item.nota}</p>}
          {item.enlace && (
            <a
              href={rutaDeCaso(idioma, item.enlace.caso)}
              class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-accent hover:underline"
            >
              {item.enlace.texto}
              <Icon
                name="lucide:arrow-right"
                class="size-4"
                aria-hidden="true"
              />
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</Section>
