---
import { Icon } from 'astro-icon/components'
import Section from '@/components/ui/Section.astro'
import Tags from '@/components/ui/Tags.astro'
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { demoDisponible, rutaDeDemo } from '@/data/demos'

interface Props {
  idioma: Idioma
}

const { idioma } = Astro.props
const t = obtenerDiccionario(idioma)
---

<Section
  id="demos"
  eyebrow={t.demos.eyebrow}
  titulo={t.demos.titulo}
  bajada={t.demos.bajada}
  alterna
>
  <ul class="grid gap-6 md:grid-cols-2">
    {t.demos.items.map((demo) => {
      const disponible = demoDisponible(demo.slug)
      return (
        <li>
          <article
            class:list={[
              'relative flex h-full flex-col rounded-2xl border border-line bg-surface p-6',
              disponible && 'group transition-colors hover:border-sky-500/40'
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-bold text-strong">
                {disponible ? (
                  <a
                    href={rutaDeDemo(idioma, demo.slug)}
                    class="after:absolute after:inset-0"
                  >
                    {demo.titulo}
                  </a>
                ) : (
                  demo.titulo
                )}
              </h3>
              {!disponible && (
                <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-line px-2.5 py-0.5 text-xs font-medium text-muted">
                  <Icon
                    name="lucide:clock"
                    class="size-3.5"
                    aria-hidden="true"
                  />
                  {t.demos.proximamente}
                </span>
              )}
            </div>
            <p class="mt-3 flex-1 text-muted">{demo.descripcion}</p>
            <div class="mt-6">
              <Tags items={demo.stack} />
            </div>
            {disponible && (
              <p class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-accent">
                <Icon name="lucide:play" class="size-4" aria-hidden="true" />
                {t.demos.probar}
              </p>
            )}
          </article>
        </li>
      )
    })}
  </ul>
</Section>
