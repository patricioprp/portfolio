---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Section from '@/components/ui/Section.astro'
import Tags from '@/components/ui/Tags.astro'
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { compararPorFechaDesc, formatearPeriodo } from '@/lib/periodo'
import { rutaDeCaso } from '@/data/casos'

interface Props {
  idioma: Idioma
}

const { idioma } = Astro.props
const t = obtenerDiccionario(idioma)
const experiencias = (await getCollection('experiencia'))
  .map((e) => e.data)
  .sort(compararPorFechaDesc)
---

<Section
  id="experiencia"
  eyebrow={t.experiencia.eyebrow}
  titulo={t.experiencia.titulo}
>
  <ol class="relative space-y-10 border-l border-line pl-8">
    {experiencias.map((exp) => (
      <li class="relative">
        <span
          aria-hidden="true"
          class:list={[
            'absolute top-1.5 -left-[2.4rem] size-3 rounded-full ring-4 ring-bg',
            exp.hasta === null ? 'bg-emerald-500' : 'bg-sky-500'
          ]}
        />
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="text-lg font-bold text-strong">
            {exp.rol[idioma]}
            <span class="font-normal text-muted"> · {exp.empresa[idioma]}</span>
          </h3>
          <p class="shrink-0 font-mono text-sm text-accent">
            {formatearPeriodo(
              exp.desde,
              exp.hasta,
              idioma,
              t.experiencia.actualidad
            )}
          </p>
        </div>
        {exp.ubicacion && (
          <p class="text-sm text-muted">{exp.ubicacion[idioma]}</p>
        )}
        {exp.nota && (
          <p class="mt-1 text-sm text-muted italic">{exp.nota[idioma]}</p>
        )}
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm marker:text-accent">
          {exp.logros[idioma].map((logro) => (
            <li>{logro}</li>
          ))}
        </ul>
        <div class="mt-4 flex flex-wrap items-center gap-4">
          <Tags items={exp.stack} />
          {exp.caso && (
            <a
              href={rutaDeCaso(idioma, exp.caso)}
              class="inline-flex items-center gap-1 text-sm font-semibold text-accent hover:underline"
            >
              {t.experiencia.verCaso}
              <Icon
                name="lucide:arrow-right"
                class="size-4"
                aria-hidden="true"
              />
            </a>
          )}
        </div>
      </li>
    ))}
  </ol>
</Section>
