---
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import { Icon } from 'astro-icon/components'
import Button from '@/components/ui/Button.astro'
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { perfil } from '@/data/perfil'

interface Props {
  idioma: Idioma
}

const { idioma } = Astro.props
const t = obtenerDiccionario(idioma)
const cv = perfil.cv[idioma]
// El botón de CV aparece solo cuando el PDF existe en public/cv/.
const hayCv = existsSync(join(process.cwd(), 'public', cv))
---

<section
  aria-labelledby="hero-titulo"
  class="relative overflow-hidden px-4 pt-36 pb-24 sm:px-6 sm:pt-44"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[56rem] -translate-x-1/2 rounded-full bg-sky-500/10 blur-3xl"
  ></div>
  <div class="relative mx-auto max-w-6xl">
    <p class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-accent-soft px-3 py-1 text-sm font-semibold text-accent">
      <span
        class="size-2 rounded-full bg-emerald-500"
        aria-hidden="true"
      ></span>
      {t.hero.disponible}
    </p>
    <h1
      id="hero-titulo"
      class="mt-6 text-4xl font-extrabold tracking-tight text-strong sm:text-6xl"
    >
      {t.hero.nombre}
    </h1>
    <p class="mt-3 font-mono text-base text-accent sm:text-lg">{t.hero.rol}</p>
    <p class="mt-8 max-w-3xl text-2xl font-semibold text-balance text-strong sm:text-3xl">
      {t.hero.propuesta}
    </p>
    <p class="mt-4 max-w-2xl text-lg text-muted">{t.hero.bajada}</p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <Button href="#casos" icono="lucide:arrow-down">
        {t.hero.verCasos}
      </Button>
      {hayCv && (
        <Button
          href={cv}
          variante="secundario"
          icono="lucide:download"
          download
        >
          {t.hero.descargarCv}
        </Button>
      )}
      <Button href="#contacto" variante="secundario" icono="lucide:mail">
        {t.hero.contactar}
      </Button>
      <div class="flex items-center gap-1 sm:ml-2">
        <a
          href={perfil.linkedin}
          class="inline-flex size-11 items-center justify-center rounded-lg text-muted hover:text-accent"
          aria-label="LinkedIn"
        >
          <Icon
            name="simple-icons:linkedin"
            class="size-6"
            aria-hidden="true"
          />
        </a>
        <a
          href={perfil.github}
          class="inline-flex size-11 items-center justify-center rounded-lg text-muted hover:text-accent"
          aria-label="GitHub"
        >
          <Icon name="simple-icons:github" class="size-6" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
