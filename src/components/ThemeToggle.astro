---
import { Icon } from 'astro-icon/components'
import { obtenerDiccionario, type Idioma } from '@/i18n'

interface Props {
  idioma: Idioma
}

const t = obtenerDiccionario(Astro.props.idioma)
---

<button
  type="button"
  id="tema-boton"
  class="inline-flex size-10 items-center justify-center rounded-md text-strong hover:bg-surface-2"
  aria-label={t.nav.temaOscuro}
  data-label-claro={t.nav.temaClaro}
  data-label-oscuro={t.nav.temaOscuro}
>
  <Icon name="lucide:sun" class="hidden size-5 dark:block" aria-hidden="true" />
  <Icon name="lucide:moon" class="size-5 dark:hidden" aria-hidden="true" />
</button>

<script>
  const boton = document.getElementById('tema-boton')
  const raiz = document.documentElement

  const actualizarEtiqueta = () => {
    if (!boton) return
    const oscuro = raiz.dataset['theme'] === 'dark'
    boton.setAttribute(
      'aria-label',
      (oscuro ? boton.dataset['labelClaro'] : boton.dataset['labelOscuro']) ??
        ''
    )
  }

  actualizarEtiqueta()
  boton?.addEventListener('click', () => {
    const nuevo = raiz.dataset['theme'] === 'dark' ? 'light' : 'dark'
    raiz.dataset['theme'] = nuevo
    try {
      localStorage.setItem('tema', nuevo)
    } catch {
      // Sin almacenamiento disponible: el cambio vale solo para esta visita.
    }
    actualizarEtiqueta()
  })
</script>
