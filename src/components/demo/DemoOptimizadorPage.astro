---
import DemoLayout from './DemoLayout.astro'
import Optimizador from '@/islands/optimizador/Optimizador'
import { obtenerDiccionario, type Idioma } from '@/i18n'

interface Props {
  idioma: Idioma
}

const { idioma } = Astro.props
const t = obtenerDiccionario(idioma).demoOptimizador
---

<DemoLayout
  idioma={idioma}
  textos={t}
  caso="optimizador-viguetas"
  codigo="src/lib/optimizador"
>
  <Optimizador client:load idioma={idioma} textos={t} />
</DemoLayout>
