---
import DemoLayout from './DemoLayout.astro'
import MapaBeneficios from '@/islands/mapa/MapaBeneficios'
import { obtenerDiccionario, type Idioma } from '@/i18n'

interface Props {
  idioma: Idioma
}

const { idioma } = Astro.props
const t = obtenerDiccionario(idioma).demoMapa
---

<DemoLayout
  idioma={idioma}
  textos={t}
  demo="mapa-beneficios"
  caso="mapa-beneficios"
  codigo="src/lib/mapa"
>
  <MapaBeneficios client:load idioma={idioma} textos={t} />
</DemoLayout>
