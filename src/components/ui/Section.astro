---
interface Props {
  id: string
  eyebrow: string
  titulo: string
  bajada?: string
  alterna?: boolean
}

const { id, eyebrow, titulo, bajada, alterna = false } = Astro.props
---

<section
  id={id}
  aria-labelledby={`${id}-titulo`}
  class:list={[
    'px-4 py-20 sm:px-6',
    alterna && 'border-y border-line bg-surface-2'
  ]}
>
  <div class="mx-auto max-w-6xl">
    <p class="font-mono text-sm font-semibold tracking-wider text-accent uppercase">
      {eyebrow}
    </p>
    <h2
      id={`${id}-titulo`}
      class="mt-2 text-3xl font-bold tracking-tight text-strong sm:text-4xl"
    >
      {titulo}
    </h2>
    {bajada && <p class="mt-4 max-w-2xl text-lg text-muted">{bajada}</p>}
    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>
