---
import type { HTMLAttributes } from 'astro/types'
import { Icon } from 'astro-icon/components'

interface Props extends HTMLAttributes<'a'> {
  href: string
  variante?: 'primario' | 'secundario'
  icono?: string
}

const { variante = 'primario', icono, class: clase, ...resto } = Astro.props
---

<a
  {...resto}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3 font-semibold transition-colors',
    variante === 'primario' &&
      'bg-accent-solid text-white shadow-lg shadow-sky-900/20 hover:bg-accent-solid-hover',
    variante === 'secundario' &&
      'border border-line bg-surface text-strong hover:bg-surface-2',
    clase
  ]}
>
  {icono && <Icon name={icono} class="size-5" aria-hidden="true" />}
  <slot />
</a>
