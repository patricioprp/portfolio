---
import { Icon } from 'astro-icon/components'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { otroIdioma, rutaInicio, type Alternos } from '@/i18n/rutas'

interface Props {
  idioma: Idioma
  alternos: Alternos
}

const { idioma, alternos } = Astro.props
const t = obtenerDiccionario(idioma)
const inicio = rutaInicio(idioma)
const otro = otroIdioma(idioma)

const enlaces = [
  { href: `${inicio}#casos`, texto: t.nav.casos },
  { href: `${inicio}#demos`, texto: t.nav.demos },
  { href: `${inicio}#experiencia`, texto: t.nav.experiencia },
  { href: `${inicio}#stack`, texto: t.nav.stack },
  { href: `${inicio}#contacto`, texto: t.nav.contacto }
]
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a
      href={inicio}
      class="font-mono text-lg font-bold tracking-wide text-accent"
      aria-label={`${t.nav.inicio} — PRP.dev`}
    >
      PRP<span class="text-strong">.dev</span>
    </a>

    <nav aria-label={t.nav.principal} class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {enlaces.map((e) => (
          <li>
            <a href={e.href} class="transition-colors hover:text-accent">
              {e.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={alternos[otro]}
        hreflang={otro}
        lang={otro}
        class="inline-flex h-10 items-center rounded-md px-2.5 font-mono text-sm font-semibold text-strong hover:bg-surface-2"
      >
        {t.nav.otroIdioma}
        <span class="sr-only">— {t.nav.otroIdiomaEtiqueta}</span>
      </a>
      <ThemeToggle idioma={idioma} />
      <button
        type="button"
        id="menu-boton"
        class="inline-flex size-10 items-center justify-center rounded-md text-strong hover:bg-surface-2 md:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label={t.nav.abrirMenu}
        data-label-abrir={t.nav.abrirMenu}
        data-label-cerrar={t.nav.cerrarMenu}
      >
        <Icon
          name="lucide:menu"
          class="size-6"
          data-icono="abrir"
          aria-hidden="true"
        />
        <Icon
          name="lucide:x"
          class="hidden size-6"
          data-icono="cerrar"
          aria-hidden="true"
        />
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    aria-label={t.nav.principal}
    class="border-t border-line bg-bg md:hidden"
    hidden
  >
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {enlaces.map((e) => (
        <li>
          <a
            href={e.href}
            class="block rounded-md px-2 py-3 text-base font-medium text-strong hover:bg-surface-2"
          >
            {e.texto}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const boton = document.getElementById('menu-boton')
  const menu = document.getElementById('menu-movil')

  if (boton && menu) {
    const iconoAbrir = boton.querySelector('[data-icono="abrir"]')
    const iconoCerrar = boton.querySelector('[data-icono="cerrar"]')

    const setAbierto = (abierto: boolean) => {
      menu.hidden = !abierto
      boton.setAttribute('aria-expanded', String(abierto))
      boton.setAttribute(
        'aria-label',
        (abierto
          ? boton.dataset['labelCerrar']
          : boton.dataset['labelAbrir']) ?? ''
      )
      iconoAbrir?.classList.toggle('hidden', abierto)
      iconoCerrar?.classList.toggle('hidden', !abierto)
    }

    const estaAbierto = () => boton.getAttribute('aria-expanded') === 'true'

    boton.addEventListener('click', () => setAbierto(!estaAbierto()))
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setAbierto(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && estaAbierto()) {
        setAbierto(false)
        boton.focus()
      }
    })
    matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
      if (e.matches) setAbierto(false)
    })
  }
</script>
