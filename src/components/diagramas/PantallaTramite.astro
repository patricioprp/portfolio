---
import Figura from './Figura.astro'
import type { Idioma } from '@/i18n'

interface Props {
  idioma: Idioma
}

const textos = {
  es: {
    titulo: 'Pantalla genérica de un trámite',
    desc: 'Maqueta de un trámite de reintegro en el paso 2 de 4. Arriba, el breadcrumb Inicio, Reintegros, Solicitar y un banner de mantenimiento programado. Debajo, el stepper con los pasos Integrante, Comprobante, Contacto y Verificación, y la carga de archivos con un comprobante adjunto. Breadcrumb, banner, stepper y carga de archivos son componentes de la librería compartida.',
    leyenda:
      'Pantalla genérica de un trámite (maqueta ilustrativa): breadcrumb, banner, stepper y carga de archivos salen de la librería compartida.',
    portal: 'Portal de socios',
    migas: 'Inicio  ›  Reintegros  ›  Solicitar',
    banner: 'Mantenimiento programado: viernes de 23:55 a 01:00',
    paso: 'Paso 2 de 4',
    pasos: ['Integrante', 'Comprobante', 'Contacto', 'Verificación'],
    adjunta: 'Adjuntá el comprobante',
    arrastra: 'Arrastrá o seleccioná un archivo',
    archivo: 'factura.pdf',
    notas: [
      ['Breadcrumb', 'igual en todos los trámites'],
      ['Banner de aviso', 'controlado por contingencias'],
      ['Stepper', 'mismo flujo y estados'],
      ['Carga de archivos', '2 pasos con URLs firmadas']
    ],
    libreria: 'Librería compartida'
  },
  en: {
    titulo: 'Generic request screen',
    desc: 'Mockup of a reimbursement request at step 2 of 4. At the top, the breadcrumb Home, Reimbursements, Request and a scheduled maintenance banner. Below, the stepper with Member, Receipt, Contact and Review, and the file upload with an attached receipt. Breadcrumb, banner, stepper and file upload come from the shared library.',
    leyenda:
      'Generic request screen (illustrative mockup): breadcrumb, banner, stepper and file upload come from the shared library.',
    portal: 'Member portal',
    migas: 'Home  ›  Reimbursements  ›  Request',
    banner: 'Scheduled maintenance: Friday 11:55 PM to 1:00 AM',
    paso: 'Step 2 of 4',
    pasos: ['Member', 'Receipt', 'Contact', 'Review'],
    adjunta: 'Attach the receipt',
    arrastra: 'Drag or choose a file',
    archivo: 'invoice.pdf',
    notas: [
      ['Breadcrumb', 'same on every request'],
      ['Notice banner', 'driven by contingencies'],
      ['Stepper', 'same flow and states'],
      ['File upload', '2 steps with signed URLs']
    ],
    libreria: 'Shared library'
  }
}[Astro.props.idioma]

// Altura (y) de cada componente en la maqueta, para las líneas de las notas.
const ancla = [86, 117, 178, 262]
---

<Figura leyenda={textos.leyenda}>
  <svg
    viewBox="0 0 760 360"
    role="img"
    aria-labelledby="pantalla-titulo pantalla-desc"
    class="w-full min-w-[640px] font-sans"
  >
    <title id="pantalla-titulo">{textos.titulo}</title>
    <desc id="pantalla-desc">{textos.desc}</desc>

    <rect
      x="20"
      y="20"
      width="470"
      height="320"
      rx="12"
      class="fill-bg stroke-line"
    ></rect>
    <rect
      x="20"
      y="20"
      width="470"
      height="44"
      rx="12"
      class="fill-surface-2"
    ></rect>
    <rect x="20" y="52" width="470" height="12" class="fill-surface-2"></rect>
    <circle cx="40" cy="42" r="5" class="fill-line"></circle>
    <circle cx="56" cy="42" r="5" class="fill-line"></circle>
    <text x="80" y="47" class="fill-strong text-[13px] font-semibold">
      {textos.portal}
    </text>

    <text x="40" y="90" class="fill-accent text-[12px]">
      {textos.migas}
    </text>

    <rect
      x="40"
      y="102"
      width="430"
      height="30"
      rx="6"
      class="fill-amber-500/15 stroke-amber-500/60"
    ></rect>
    <text x="54" y="122" class="fill-strong text-[12px]">
      ⚠ {textos.banner}
    </text>

    <text x="40" y="156" class="fill-muted text-[11px]">
      {textos.paso}
    </text>
    {textos.pasos.map((p, i) => {
      const x = 52 + i * 108
      const estado = i < 1 ? 'hecho' : i === 1 ? 'actual' : 'pendiente'
      return (
        <g>
          {i > 0 && (
            <path
              d={`M${x - 96} 178 H${x - 12}`}
              stroke-width="2"
              class={i <= 1 ? 'stroke-accent' : 'stroke-line'}
            />
          )}
          <circle
            cx={x}
            cy="178"
            r="11"
            class={
              estado === 'pendiente'
                ? 'fill-surface-2 stroke-line'
                : 'fill-accent-solid stroke-accent'
            }
          />
          <text
            x={x}
            y="182"
            text-anchor="middle"
            class={`text-[11px] font-bold ${estado === 'pendiente' ? 'fill-muted' : 'fill-white'}`}
          >
            {estado === 'hecho' ? '✓' : i + 1}
          </text>
          <text
            x={x}
            y="205"
            text-anchor="middle"
            class={`text-[11px] ${estado === 'actual' ? 'fill-strong font-semibold' : 'fill-muted'}`}
          >
            {p}
          </text>
        </g>
      )
    })}

    <text x="40" y="236" class="fill-strong text-[13px] font-semibold">
      {textos.adjunta}
    </text>
    <rect
      x="40"
      y="246"
      width="430"
      height="44"
      rx="8"
      stroke-dasharray="5 4"
      class="fill-surface-2 stroke-accent"
    ></rect>
    <text x="255" y="273" text-anchor="middle" class="fill-muted text-[12px]">
      {textos.arrastra}
    </text>
    <rect
      x="40"
      y="298"
      width="430"
      height="28"
      rx="6"
      class="fill-surface stroke-line"
    ></rect>
    <text x="54" y="317" class="fill-fg font-mono text-[11px]">
      📄 {textos.archivo}
    </text>
    <text
      x="456"
      y="317"
      text-anchor="end"
      class="fill-emerald-600 text-[12px] font-bold"
    >
      ✓
    </text>

    <text
      x="530"
      y="40"
      class="fill-accent font-mono text-[11px] font-semibold tracking-wider"
    >
      {textos.libreria.toUpperCase()}
    </text>
    {textos.notas.map(([nombre, detalle], i) => {
      const y = 70 + i * 66
      return (
        <g>
          <path
            d={`M${i === 0 ? 300 : 474} ${ancla[i]} H500 L522 ${y + 14}`}
            fill="none"
            stroke-width="1.2"
            stroke-dasharray="3 3"
            class="stroke-accent"
          />
          <circle
            cx={i === 0 ? 300 : 474}
            cy={ancla[i]}
            r="3"
            class="fill-accent"
          />
          <rect
            x="526"
            y={y}
            width="214"
            height="48"
            rx="8"
            class="fill-surface-2 stroke-line"
          />
          <text
            x="540"
            y={y + 20}
            class="fill-strong text-[12.5px] font-semibold"
          >
            {nombre}
          </text>
          <text x="540" y={y + 37} class="fill-muted text-[11px]">
            {detalle}
          </text>
        </g>
      )
    })}
  </svg>
</Figura>
