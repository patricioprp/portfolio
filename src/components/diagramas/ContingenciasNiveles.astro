---
import Figura from './Figura.astro'
import type { Idioma } from '@/i18n'

interface Props {
  idioma: Idioma
}

const textos = {
  es: {
    titulo: 'Contingencias en tiempo real',
    desc: 'Una configuración remota en Firebase Remote Config, que el app shell consulta cada 60 segundos, controla tres niveles de respuesta: mantenimiento total por fecha o forzado, un trámite apagado que deja de estar disponible, y un banner de aviso con fecha y horario. Todo sin deploys.',
    leyenda:
      'Una única configuración remota controla tres niveles de respuesta, sin deploys.',
    remote: 'Remote Config',
    remoteD: 'Firebase',
    shell: 'App shell',
    shellD: 'Consulta cada 60 s',
    niveles: [
      ['Mantenimiento total', 'Por fecha o forzado'],
      ['Trámite apagado', 'No disponible'],
      ['Banner de aviso', 'Fecha y horario']
    ],
    sinDeploys: 'Sin deploys',
    gravedad: 'mayor impacto  →  menor impacto'
  },
  en: {
    titulo: 'Real-time contingencies',
    desc: 'A remote configuration in Firebase Remote Config, which the app shell polls every 60 seconds, controls three response levels: full maintenance by date or forced, a request turned off that becomes unavailable, and a notice banner with date and time. All without deploys.',
    leyenda:
      'A single remote configuration controls three response levels, with no deploys.',
    remote: 'Remote Config',
    remoteD: 'Firebase',
    shell: 'App shell',
    shellD: 'Polls every 60 s',
    niveles: [
      ['Full maintenance', 'By date or forced'],
      ['Request off', 'Unavailable'],
      ['Notice banner', 'Date and time']
    ],
    sinDeploys: 'No deploys',
    gravedad: 'higher impact  →  lower impact'
  }
}[Astro.props.idioma]

const colores = [
  'fill-rose-500/15 stroke-rose-500',
  'fill-amber-500/15 stroke-amber-500',
  'fill-accent-soft stroke-accent'
]
const xs = [20, 270, 520]
---

<Figura leyenda={textos.leyenda}>
  <svg
    viewBox="0 0 760 300"
    role="img"
    aria-labelledby="cont-titulo cont-desc"
    class="w-full min-w-[640px] font-sans"
  >
    <title id="cont-titulo">{textos.titulo}</title>
    <desc id="cont-desc">{textos.desc}</desc>
    <defs>
      <marker
        id="cont-flecha"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" class="fill-muted"></path>
      </marker>
    </defs>

    <rect
      x="120"
      y="20"
      width="200"
      height="62"
      rx="10"
      class="fill-surface-2 stroke-line"
    ></rect>
    <text
      x="220"
      y="47"
      text-anchor="middle"
      class="fill-strong text-[15px] font-semibold"
    >
      {textos.remote}
    </text>
    <text x="220" y="68" text-anchor="middle" class="fill-muted text-[12px]">
      {textos.remoteD}
    </text>

    <path
      d="M324 51 H436"
      stroke-width="1.5"
      marker-end="url(#cont-flecha)"
      marker-start="url(#cont-flecha)"
      class="stroke-muted"
    ></path>
    <text
      x="380"
      y="42"
      text-anchor="middle"
      class="fill-accent font-mono text-[11px]"
    >
      JSON
    </text>

    <rect
      x="440"
      y="20"
      width="200"
      height="62"
      rx="10"
      class="fill-accent-soft stroke-accent"
    ></rect>
    <text
      x="540"
      y="47"
      text-anchor="middle"
      class="fill-strong text-[15px] font-semibold"
    >
      {textos.shell}
    </text>
    <text x="540" y="68" text-anchor="middle" class="fill-muted text-[12px]">
      {textos.shellD}
    </text>

    <g stroke-width="1.5" fill="none" class="stroke-muted">
      <path d="M540 82 V110"></path>
      <path d="M130 110 H630"></path>
      <path d="M130 110 V136" marker-end="url(#cont-flecha)"></path>
      <path d="M380 110 V136" marker-end="url(#cont-flecha)"></path>
      <path d="M630 110 V136" marker-end="url(#cont-flecha)"></path>
    </g>

    {textos.niveles.map(([nombre, detalle], i) => (
      <g>
        <rect
          x={xs[i]}
          y="140"
          width="220"
          height="68"
          rx="10"
          class={colores[i]}
        />
        <text
          x={(xs[i] ?? 0) + 110}
          y="170"
          text-anchor="middle"
          class="fill-strong text-[14px] font-semibold"
        >
          {nombre}
        </text>
        <text
          x={(xs[i] ?? 0) + 110}
          y="192"
          text-anchor="middle"
          class="fill-muted text-[12px]"
        >
          {detalle}
        </text>
      </g>
    ))}

    <path d="M20 236 H740" stroke-width="1" class="stroke-line"></path>
    <text x="20" y="262" class="fill-muted text-[12px]">
      {textos.gravedad}
    </text>
    <text
      x="740"
      y="262"
      text-anchor="end"
      class="fill-emerald-600 text-[13px] font-semibold"
    >
      ✓ {textos.sinDeploys}
    </text>
  </svg>
</Figura>
