---
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { perfil } from '@/data/perfil'

interface Props {
  idioma: Idioma
  titulo: string
  descripcion: string
  noIndex: boolean
}

const { idioma, titulo, descripcion, noIndex } = Astro.props
const t = obtenerDiccionario(idioma)
const canonical = new URL(Astro.url.pathname, Astro.site)
const imagen = new URL('/og/default.png', Astro.site)

const personaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  jobTitle: t.meta.tituloPersona,
  url: new URL('/', Astro.site).href,
  email: `mailto:${perfil.email}`,
  sameAs: [perfil.linkedin, perfil.github],
  address: {
    '@type': 'PostalAddress',
    addressLocality: perfil.localidad,
    addressCountry: perfil.pais
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad Tecnológica Nacional — Facultad Regional Tucumán'
  },
  knowsAbout: ['React', 'TypeScript', 'Node.js', 'Laravel', 'Playwright']
}
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />
{noIndex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#0f172a" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={perfil.nombre} />
<meta property="og:locale" content={idioma === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagen} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={titulo} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagen} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(personaJsonLd)}
/>
