---
import { obtenerDiccionario, type Idioma } from '@/i18n'
import { perfil } from '@/data/perfil'
import type { Alternos } from '@/i18n/rutas'

interface Props {
  idioma: Idioma
  titulo: string
  descripcion: string
  noIndex: boolean
  alternos: Alternos
  imagen: string
}

const { idioma, titulo, descripcion, noIndex, alternos } = Astro.props
const t = obtenerDiccionario(idioma)
const canonical = new URL(Astro.url.pathname, Astro.site)
const imagen = new URL(Astro.props.imagen, Astro.site)
const url = (ruta: string) => new URL(ruta, Astro.site).href

const personaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  jobTitle: t.meta.tituloPersona,
  url: url(idioma === 'es' ? '/' : '/en/'),
  email: `mailto:${perfil.email}`,
  sameAs: [perfil.linkedin, perfil.github],
  address: {
    '@type': 'PostalAddress',
    addressLocality: perfil.localidad,
    addressCountry: perfil.pais
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad Tecnológica Nacional — Facultad Regional Tucumán'
  },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'degree',
    name: 'Ingeniería en Sistemas de Información'
  },
  knowsAbout: ['React', 'TypeScript', 'Node.js', 'Laravel', 'Playwright']
}
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />
{noIndex && <meta name="robots" content="noindex" />}
{!noIndex && (
  <>
    <link rel="alternate" hreflang="es" href={url(alternos.es)} />
    <link rel="alternate" hreflang="en" href={url(alternos.en)} />
    <link rel="alternate" hreflang="x-default" href={url(alternos.es)} />
  </>
)}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#0f172a" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={perfil.nombre} />
<meta property="og:locale" content={idioma === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagen} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={titulo} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagen} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(personaJsonLd)}
/>
